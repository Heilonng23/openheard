VITE_OPENPANEL_CLIENT_ID=
VITE_OPENPANEL_URL=

# openheard's own feedback board. Its widget loads only on the marketing pages
# of a ROOT_DOMAIN it lives under, so self-hosted installs never load it.
VITE_OFFICIAL_FEEDBACK_BOARD=

# Optional: server-side revenue tracking from the Stripe webhook. Needs a
# client with write access, which is a different client from the VITE_ one
# above. Leave blank and no analytics request is ever made.
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=
# Ingest base URL, the one /track hangs off. Blank uses OpenPanel cloud. When
# self-hosting this is the API origin, which is the client URL plus /api.
OPENPANEL_URL=
