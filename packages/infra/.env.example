# Required: 32+ char random string (openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Your root domain for multi-workspace subdomains (e.g. openheard.com). Leave blank for single-workspace.
ROOT_DOMAIN=

# Public URL of the worker. Defaults to the Cloudflare .workers.dev URL if blank. Set to your custom domain (e.g. https://openheard.com) for cross-subdomain auth cookies.
BETTER_AUTH_URL=

# Optional: the sender for magic links and notifications. Must be on a domain with Cloudflare Email Sending enabled.
# Leave blank to use hello@openheard.com (only works on openheard's own account).
EMAIL_FROM=
EMAIL_FROM_NAME=
# Optional: where replies go. Useful when EMAIL_FROM is a send-only address with no inbox.
EMAIL_REPLY_TO=

# Optional: Google OAuth for "Sign in with Google". Leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: behind Cloudflare Access, sign people in with their Access identity instead of a second login.
# Team domain from Zero Trust > Settings (e.g. yourteam.cloudflareaccess.com); AUD tag from the Access application's overview.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
