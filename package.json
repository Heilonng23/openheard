{
  "name": "openheard",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^26.2.0",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@libsql/client": "0.17.4",
      "libsql": "0.5.29",
      "better-auth": "1.7.1",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:web": "bun run --filter web dev:bare",
    "db:generate": "bun run --filter @openheard/db db:generate",
    "deploy": "bun run --filter @openheard/infra deploy",
    "destroy": "bun run --filter @openheard/infra destroy",
    "dev:local": "OPENHEARD_LOCAL=1 bun run --filter web dev:bare",
    "db:push:local": "bun run --filter @openheard/db db:push:local",
    "db:seed": "OPENHEARD_LOCAL=1 bun run --filter web seed"
  },
  "dependencies": {
    "@openheard/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@openheard/config": "workspace:*",
    "@types/node": "catalog:",
    "oxc-transform-react": "^0.149.0",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.11"
}
